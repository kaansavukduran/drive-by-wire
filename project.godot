; Engine configuration file.
config_version=5

[application]

config/name="Drive-By Wire"
config/description="Fragaria Interactive · Fragaria Games · AIONIA. Ok tuşlarıyla sür, İLİN ile üç arcade etabını aş; seçimlerinle 13 farklı gelecek aç."
config/version="0.6.2"
run/main_scene="res://scenes/loading.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
run/max_fps=60
config/icon="res://assets/brand/ilin-icon.png"
boot_splash/show_image=false
boot_splash/bg_color=Color(0, 0, 0, 1)

[autoload]

DisplayLayout="*res://scripts/game/display_layout.gd"
Appearance="*res://scripts/game/appearance.gd"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=6

[rendering]

environment/defaults/default_clear_color=Color(0.043, 0.051, 0.071, 1)
textures/vram_compression/import_etc2_astc=true

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
2d/snap/snap_2d_transforms_to_pixel=true
