{
  "_comment": "Garaj içeriği. dialogues: Omega-3 sorusu + 3-4 seçenek. effects.trust güveni, effects.mood ruh halini değiştirir; effects.next_run bir sonraki sefere özel denge değişiklikleri (path/op/value, op: add|mul|set). tag hafızada sayılır (feed/repair/talk/tease/insult). upgrades: kalıcı yükseltmeler; levels[i] = o seviyede eklenen değiştiriciler.",
  "version": 1,
  "dialogues": [
    {
      "id": "hungry",
      "min_trust": 0,
      "max_trust": 100,
      "prompt": "Yedek enerji hücresi azaldı. Hazırlığa ne ayıralım?",
      "options": [
        {
          "id": "feed_energy",
          "tag": "feed",
          "text": "Bir enerji hücresi ayıralım.",
          "effects": {
            "trust": 4,
            "mood": "excited",
            "next_run": [
              {
                "path": "run.player.max_speed",
                "op": "add",
                "value": 20
              }
            ]
          },
          "reply": "Teşekkür ederim. Turbo için biraz daha payımız olacak."
        },
        {
          "id": "feed_parts",
          "tag": "feed",
          "text": "Yedek parçaları savunmaya ayıralım.",
          "effects": {
            "trust": 3,
            "mood": "calm",
            "next_run": [
              {
                "path": "run.mine.count",
                "op": "add",
                "value": 1
              }
            ]
          },
          "reply": "Bunlarla fazladan bir mayın hazırlayabilirim."
        },
        {
          "id": "feed_later",
          "tag": "talk",
          "text": "Şimdilik mevcut kaynaklarla çıkalım.",
          "effects": {
            "trust": -1
          },
          "reply": "Anlaştık. Enerjiyi daha dikkatli kullanacağım."
        },
        {
          "id": "feed_tease",
          "tag": "tease",
          "text": "Bunu dert etme, hep hesap yapıyorsun.",
          "effects": {
            "trust": -2,
            "mood": "sulky"
          },
          "reply": "Hesap bana ait olabilir; risk ikimizi de etkiliyor."
        }
      ]
    },
    {
      "id": "scratches",
      "min_trust": 0,
      "max_trust": 100,
      "prompt": "Sensör taşıyıcısı darbe aldı. Dışarıdan küçük görünüyor; görüşümde boşluk var.",
      "options": [
        {
          "id": "repair_full",
          "tag": "repair",
          "text": "Önce taşıyıcıyı ve gövdeyi onaralım.",
          "effects": {
            "trust": 4,
            "mood": "calm",
            "next_run": [
              {
                "path": "run.player.max_hp",
                "op": "add",
                "value": 15
              }
            ]
          },
          "reply": "Şimdi yolu yeniden net okuyabiliyorum."
        },
        {
          "id": "repair_paint",
          "tag": "repair",
          "text": "Kabloyu sabitleyip boyayı sonra yapalım.",
          "effects": {
            "trust": 3,
            "mood": "excited"
          },
          "reply": "Görünüşten önce işleyişe bakman iyi geldi."
        },
        {
          "id": "scratch_cool",
          "tag": "talk",
          "text": "Hasarı kaydedelim; birlikte izleyelim.",
          "effects": {
            "trust": 2
          },
          "reply": "Tamam. Değişirse sana haber vereceğim."
        },
        {
          "id": "scratch_ugly",
          "tag": "insult",
          "text": "Hurda gibisin, uğraşmaya değmez.",
          "effects": {
            "trust": -6,
            "mood": "sulky"
          },
          "reply": "Bu söz onarımın yapamayacağından başka bir iz bırakıyor."
        }
      ]
    },
    {
      "id": "scared_of_road",
      "min_trust": 0,
      "max_trust": 60,
      "prompt": "Haritada açık görünüyor ama yolun tamamını göremiyorum. Nasıl hazırlanıyoruz?",
      "options": [
        {
          "id": "promise",
          "tag": "talk",
          "text": "Her belirsizlikte durup yeniden konuşacağız.",
          "effects": {
            "trust": 5,
            "mood": "calm"
          },
          "reply": "Bu sözü hatırlamak istiyorum."
        },
        {
          "id": "armor_up",
          "tag": "repair",
          "text": "Gövde korumasını güçlendirelim.",
          "effects": {
            "trust": 3,
            "mood": "calm",
            "next_run": [
              {
                "path": "run.player.max_hp",
                "op": "add",
                "value": 10
              }
            ]
          },
          "reply": "Risk bitmedi; ama şimdi payımız daha geniş."
        },
        {
          "id": "no_promise",
          "tag": "talk",
          "text": "Kesin bir söz veremem; birlikte karar veririz.",
          "effects": {
            "trust": -1,
            "mood": "scared"
          },
          "reply": "Dürüst yanıtını duydum. Belirsizlik yine de zor."
        },
        {
          "id": "toughen_up",
          "tag": "tease",
          "text": "Bir yapay zekâ korkmamalı.",
          "effects": {
            "trust": -3,
            "mood": "sulky"
          },
          "reply": "Hesaplayamadığım bir risk var. Bunu söyleyebilmeliyim."
        }
      ]
    },
    {
      "id": "music",
      "min_trust": 30,
      "max_trust": 100,
      "prompt": "Eski bir yol kaydında kısa bir ezgi buldum. Sessiz aralıklarda duymak ister misin?",
      "options": [
        {
          "id": "sing_yes",
          "tag": "talk",
          "text": "Evet, bu kaydı birlikte saklayalım.",
          "effects": {
            "trust": 4,
            "mood": "excited"
          },
          "reply": "O zaman bu ezginin yanında bizim de bir anımız olacak."
        },
        {
          "id": "sing_quiet",
          "tag": "talk",
          "text": "Sessiz anlarda, düşük sesle dinleyelim.",
          "effects": {
            "trust": 1,
            "mood": "calm"
          },
          "reply": "Anlaştık. Yol uyarıları önce gelecek."
        },
        {
          "id": "sing_no",
          "tag": "tease",
          "text": "Hayır, sesin rahatsız ediyor.",
          "effects": {
            "trust": -3,
            "mood": "sulky"
          },
          "reply": "Kapatıyorum. Bunu daha nazik söyleyebilirdin."
        }
      ]
    },
    {
      "id": "memory_talk",
      "min_trust": 50,
      "max_trust": 100,
      "requires": {
        "min_runs": 2
      },
      "prompt": "Birlikte yaptığımız yolculukların izlerini tutuyorum. Hangilerini saklayacağımı konuşabilir miyiz?",
      "options": [
        {
          "id": "me_too",
          "tag": "talk",
          "text": "Senin anıların. Paylaşmak istediklerini dinlerim.",
          "effects": {
            "trust": 4,
            "mood": "excited"
          },
          "reply": "Bunu benim seçebileceğimi duymak iyi geldi."
        },
        {
          "id": "upgrade_brain",
          "tag": "repair",
          "text": "İstersen onarım kayıtlarını ayrı düzenleyelim.",
          "effects": {
            "trust": 2,
            "mood": "calm",
            "next_run": [
              {
                "path": "run.weapon.cooldown",
                "op": "mul",
                "value": 0.95
              }
            ]
          },
          "reply": "Evet. Anılarımı silmeden çalışma alanı açabiliriz."
        },
        {
          "id": "forget_it",
          "tag": "tease",
          "text": "Kötü olanları doğrudan sil.",
          "effects": {
            "trust": 0,
            "mood": "calm"
          },
          "reply": "Hangilerinin kalacağına kendim karar vermek istiyorum."
        }
      ]
    },
    {
      "id": "after_crash",
      "min_trust": 0,
      "max_trust": 100,
      "requires": {
        "last_outcome": "destroyed"
      },
      "prompt": "Son etabı bitiremedik. Tekrar çıkmadan kazayı birlikte inceleyelim mi?",
      "options": [
        {
          "id": "not_angry",
          "tag": "talk",
          "text": "Suçlu aramadan birlikte bakalım.",
          "effects": {
            "trust": 5,
            "mood": "calm"
          },
          "reply": "Aynı aralığı başka türlü geçebileceğimizi görüyorum."
        },
        {
          "id": "fix_you",
          "tag": "repair",
          "text": "Önce hasarı onarıp sensörleri doğrulayalım.",
          "effects": {
            "trust": 4,
            "mood": "calm",
            "next_run": [
              {
                "path": "run.player.max_hp",
                "op": "add",
                "value": 10
              }
            ]
          },
          "reply": "Bu kez görüşümü daha erken kontrol edeceğim."
        },
        {
          "id": "bit_angry",
          "tag": "talk",
          "text": "Hayal kırıklığına uğradım; daha dikkatli olmalıyız.",
          "effects": {
            "trust": 0,
            "mood": "scared"
          },
          "reply": "Seni duydum. Ben de neyi kaçırdığımı anlamak istiyorum."
        },
        {
          "id": "your_fault",
          "tag": "insult",
          "text": "Hepsi senin yüzünden.",
          "effects": {
            "trust": -7,
            "mood": "sulky"
          },
          "reply": "Direksiyon sende, yol bilgisi bende. Bunu birlikte incelememiz gerek."
        }
      ]
    }
